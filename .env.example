# 複製此檔為 .env 並填入真實值

# ── 環境切換 ────────────────────────────────────────────────────────────────
# dev  → Claude Haiku（低成本，適合開發測試，約 Sonnet 費用 1/10）
# prod → Claude Sonnet（高品質，正式環境，啟用 extended thinking）
ENV=dev

# ── Anthropic Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Groq Whisper API（備援雲端轉錄，2000 次/日免費）────────────────────────────
GROQ_API_KEY=gsk_...
# WHISPER_BACKEND=auto   # auto（優先 groq，失敗 fallback faster-whisper）
#                        # groq（強制使用 Groq API）
#                        # local（強制使用 faster-whisper）

# ── faster-whisper ──────────────────────────────────────────────────────────
# 模型尺寸：tiny / base / small / medium / large-v3
# Oracle VM（24GB RAM）建議使用 large-v3；本機開發建議 base
WHISPER_MODEL=base
WHISPER_DEVICE=cpu        # cpu / cuda（有 GPU 時改為 cuda）
WHISPER_COMPUTE=int8      # int8 / float16 / float32
CHUNK_DURATION_MS=600000  # 音檔切片長度（毫秒），預設 10 分鐘

# ── Email SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your@gmail.com
EMAIL_RECIPIENTS=subscriber1@example.com,subscriber2@example.com

# ── Pexels（免費圖片，generate_assets.py 使用）──────────────────────────────
# 申請免費 Key：https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key

# ── Google AI Studio（Nano Banana 圖片生成，需開啟 Billing）────────────────
GOOGLE_AI_STUDIO_API_KEY=AIza...

# ── Discord Bot ──────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_OWNER_ID=your_discord_user_id    # 右鍵你的帳號 → 複製使用者 ID（需開啟開發者模式）
DISCORD_CHANNEL_ID=your_channel_id      # Bot 發文頻道 ID（選填）

# ── YouTube Data API（儀表板社群流量用）────────────────────────────────────────
# 申請：Google Cloud Console → 啟用 YouTube Data API v3 → 建立 API Key
YOUTUBE_API_KEY=AIza...
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxx   # 頻道 ID（以 UC 開頭，在頻道頁面 → 關於 → 分享 → 複製頻道 ID）

# ── Instagram Graph API（選填）──────────────────────────────────────────────
# 需要 Meta 開發者帳號 + Instagram Business 帳號
IG_ACCESS_TOKEN=
IG_USER_ID=

# ── Threads API（選填）──────────────────────────────────────────────────────
# Meta 開發者帳號 + Threads API 存取
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
