{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/chat.js": {
      "runtime": "nodejs20.x"
    },
    "api/dashboard-chat.js": {
      "runtime": "nodejs20.x"
    },
    "api/social-stats.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/d",        "destination": "/d.html" }
  ]
}
